# Copia este archivo a ".env" y rellena los valores. El ".env" NUNCA se sube a git.

# ---- Servidor ----------------------------------------------------------------
PORT=4000
# En producción: NODE_ENV=production (exige un JWT_SECRET de al menos 32 caracteres)
NODE_ENV=development

# Cadena de conexión de PostgreSQL. En desarrollo con docker compose:
DATABASE_URL=postgresql://biblioteca_user:biblioteca_pass@localhost:5432/biblioteca_db

# Secreto con el que se firman los tokens de sesión. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes que pueden llamar a la API, separados por comas. Vacío = cualquiera.
# La app de escritorio llama desde el origen "app://gamehub": hay que incluirlo.
# Ejemplo: CORS_ORIGINS=app://gamehub,https://gamehub.ejemplo.com
CORS_ORIGINS=

# Cuántos proxies hay delante del servidor (nginx, Render, Fly...). 1 en casi todos;
# vacío si el servidor recibe las peticiones directamente. Los límites de intentos
# lo necesitan para ver la IP real de cada usuario.
TRUST_PROXY=

# ---- IGDB (datos de los juegos) -------------------------------------------------
# Credenciales de https://dev.twitch.tv/console (aplicación de Twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Steam ---------------------------------------------------------------------
# Clave de https://steamcommunity.com/dev/apikey (gratuita). Sin ella no se puede vincular.
STEAM_API_KEY=
# Cada cuántos minutos se sincronizan solas las cuentas vinculadas (0 = desactivado).
# La clave tiene un tope de 100.000 consultas al día para TODOS los usuarios.
STEAM_SYNC_MINUTOS=60

# ---- Correo (recuperación de contraseña) -------------------------------------------
# Brevo (plan gratuito: 300 correos al día, sin tarjeta). Se usa su API HTTP porque
# Render bloquea SMTP en el plan gratuito. Pasos en docs/DESPLIEGUE.md.
# Sin BREVO_API_KEY, en desarrollo el correo se escribe en la consola del backend.
BREVO_API_KEY=
# Email verificado como remitente en Brevo (Remitentes, dominios e IP dedicadas)
CORREO_REMITENTE=
CORREO_NOMBRE=GameHub

# ---- Traducción de descripciones (opcional) ---------------------------------------
# Azure AI Translator (mejor calidad, plan gratuito F0: 2 millones de caracteres al mes)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# LibreTranslate (reserva, sin claves). En Docker Compose se sobrescribe solo.
TRANSLATE_URL=http://localhost:5000
